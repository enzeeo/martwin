  "dunes": {
    "description": "Presence of mapped dunes and proximity to mapped dune fields. Earth and Mars source catalogues differ.",
    "options": [
      {
        "header": "dune_frac",
        "stat": "mapped dune presence",
        "meaning": "Use dune_frac>0 as a presence proxy, not a numerically comparable fraction",
        "compare_mode": "presence_proxy",
        "caution": "Earth GSDP30 fraction counts four mapped dune classes and has footprint/coverage gaps; Mars MGD3 uses different source mapping. Presence is a proxy, not a calibrated cross-planet fraction.",
        "layers": {
          "mars": "mgd3_dunes",
          "earth": "earth_dunes_fraction"
        },
        "sources": {
          "mars": {
            "layer": "mgd3_dunes",
            "version": "mgd3_dunes-v0.2",
            "column": "dune_frac"
          },
          "earth": {
            "layer": "earth_dunes_fraction",
            "version": "earth_dunes_fraction-v0.4",
            "column": "dune_frac"
          }
        },
        "scoring_status": "proxy_requires_review"
      },
      {
        "header": "dist_dune_km",
        "stat": "distance to dunes",
        "meaning": "proximity to the nearest mapped dune area",
        "compare_mode": "proxy_review",
        "caution": "Earth distance uses the retained mapped dune model. Source gaps and differences in mapping between planets limit scientific comparison.",
        "layers": {
          "mars": "mgd3_dunes",
          "earth": "earth_dunes_distance"
        },
        "sources": {
          "mars": {
            "layer": "mgd3_dunes",
